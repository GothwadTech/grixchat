# ─────────────────────────────────────────────────────────────────────────────
# GrixChat environment template
#
#   cp .env.example .env          # local development
#
# Production runs on **Cloudflare Pages** (https://grixchat.gothwadtech.com).
# Every variable below goes into the Pages project:
#   Cloudflare dashboard → Workers & Pages → gtwdchat → Settings → Environment
#   variables  (add each one to **Production** and **Preview**)
#
# Everything prefixed VITE_ is inlined into the browser bundle at build time —
# never put a real secret there. Changing one requires a redeploy.
#
# 💡 You do not need any of this for local development. `npm run dev:mock`
#    runs the full app against an in-memory mock with seeded data.
#    See docs/DEV_SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Firebase Cloud Messaging (public web config) ─────────────────────────────
# FCM only. No Firestore, no Firebase Auth, no Firebase Storage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_DATABASE_URL=

# ── LiveKit (client URL only; keys stay on the server) ───────────────────────
VITE_LIVEKIT_URL=

# ── Server-only secrets ──────────────────────────────────────────────────────
# Never prefix these with VITE_. On Cloudflare these are Pages environment
# variables; the Functions read them per request (they are not inlined).
#
# ⚠️ These CANNOT be read from a local `.env` inside the edge Functions — only
#    the Node dev server (`npm run dev`) loads `.env`. For `wrangler pages dev`
#    put them in `.dev.vars` (gitignored).

# Gemini, for the /api/grix-ai proxy
GEMINI_API_KEY=

# FCM service account, for /api/send-notification.
# Paste the whole JSON object; literal \n sequences in private_key are healed
# automatically.
FIREBASE_SERVICE_ACCOUNT=

# LiveKit token signing, for /api/livekit-token
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GitHub OAuth, for /api/github/auth-url
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-side Supabase client (bypasses RLS — server only).
# Needed for push fan-out and FCM token cleanup.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin: OAuth redirect base and the first entry of the CORS /
# origin allowlist.  https://grixchat.gothwadtech.com
APP_URL=

# Extra browser origins allowed to call /api/* (comma-separated).
# Same-origin requests are always allowed, so this is only needed when the
# frontend and the API live on different hosts.
ALLOWED_ORIGINS=

# ── Runtime flags ────────────────────────────────────────────────────────────
# Node dev server only: "production" serves dist/ instead of Vite middleware.
# Not needed on Cloudflare — but if you want the diagnostic route
# `/api/github/debug` to 404 everywhere, set NODE_ENV=production in the Pages
# environment as well (it is already hidden on any Pages deployment).
NODE_ENV=

# Node dev server only (`npm run dev:mock`) — skips JWT verification for the
# in-memory mock. Ignored on Cloudflare: the edge has no mock database, so it
# always verifies.
MOCK_SUPABASE=

# Port for the Node dev server. Cloudflare ignores it.
PORT=

# Node version used by the Cloudflare Pages build (`20`). Set it in the Pages
# environment variables rather than here.
NODE_VERSION=

# ── Optional ─────────────────────────────────────────────────────────────────
# Path prefix for a sub-path deploy. Cloudflare Pages serves from the domain
# root, so leave this alone unless you deliberately deploy under a prefix.
# Cloudflare Pages serves from the domain root — leave empty.
VITE_BASE_URL=
