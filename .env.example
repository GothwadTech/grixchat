# ─────────────────────────────────────────────────────────────────────────────
# GrixChat environment template
#
#   cp .env.example .env
#
# Everything prefixed VITE_ is inlined into the browser bundle — never put a
# real secret there.
#
# 💡 You do not need any of this for local development. `npm run dev:mock`
#    runs the full app against an in-memory mock with seeded data.
#    See docs/DEV_SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Firebase Cloud Messaging (public web config) ─────────────────────────────
# FCM only. No Firestore, no Firebase Auth, no Firebase Storage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_DATABASE_URL=

# ── LiveKit (client URL only; keys stay on the server) ───────────────────────
VITE_LIVEKIT_URL=

# ── Server-only secrets ──────────────────────────────────────────────────────
# Never prefix these with VITE_.

# Gemini, for the /api/grix-ai proxy
GEMINI_API_KEY=

# FCM service account, for /api/send-notification.
# Paste the whole JSON object; literal \n sequences in private_key are healed
# automatically by server.ts.
FIREBASE_SERVICE_ACCOUNT=

# LiveKit token signing, for /api/livekit-token
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GitHub OAuth, for /api/github/auth-url
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-side Supabase client (bypasses RLS — server only)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build OAuth redirects
APP_URL=

# Set to "production" to serve dist/ instead of the Vite dev middleware
NODE_ENV=

# ── Optional ─────────────────────────────────────────────────────────────────
# Path prefix when deploying to a sub-path (e.g. GitHub Pages "/grixchat/").
# Leave empty or "/" for a root deploy.
VITE_BASE_URL=
