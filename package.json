{
  "name": "grixchat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.5.0",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:mock": "MOCK_SUPABASE=1 tsx server.ts",
    "build": "vite build",
    "build:all": "npm run build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:mock": "MOCK_SUPABASE=1 vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "preview:mock": "MOCK_SUPABASE=1 vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint:eslint": "eslint .",
    "lint:all": "npm run lint && npm run lint:eslint",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/messaging": "^0.13.3",
    "@livekit/components-react": "^2.9.21",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.14.0",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.19.1",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "jszip": "^3.10.1",
    "livekit-client": "^2.19.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  }
}
