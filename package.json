{
  "name": "grixchat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.5.0",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:mock": "MOCK_SUPABASE=1 tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:mock": "MOCK_SUPABASE=1 vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "preview:mock": "MOCK_SUPABASE=1 vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@livekit/components-react": "^2.9.21",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.19.1",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.14.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.4"
  }
}
